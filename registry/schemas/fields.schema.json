{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/registry/schemas/fields.schema.json",
  "title": "Viveka calibration field (registry/fields/<field>.yaml): corpus part and commitments",
  "type": "object",
  "required": [
    "format",
    "field",
    "role",
    "side",
    "window",
    "frames",
    "absent_venues"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        1,
        2
      ]
    },
    "field": {
      "$ref": "#/$defs/slug"
    },
    "role": {
      "const": "calibration"
    },
    "side": {
      "enum": [
        "science",
        "pseudoscience"
      ]
    },
    "notes": {
      "type": "string"
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "end": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "sources"
            ]
          },
          {
            "required": [
              "ingest"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "community",
              "mainstream"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^S\\d+$"
            }
          },
          "ingest": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "absent_venues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "issn_l",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "issn_l": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{3}[\\dX]$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "seeds",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "claim": {
            "$ref": "#/$defs/slug"
          },
          "seeds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/work"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "openalex"
          ]
        },
        {
          "required": [
            "doi"
          ]
        }
      ],
      "properties": {
        "openalex": {
          "type": "string",
          "pattern": "^W\\d+$"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\S+/\\S+$"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": 2
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "required": [
          "commitments"
        ]
      },
      "else": {
        "not": {
          "required": [
            "commitments"
          ]
        }
      }
    }
  ]
}
