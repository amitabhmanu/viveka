{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/registry/schemas/instrument.schema.json",
  "title": "Viveka instrument registry",
  "type": "object",
  "required": ["version", "state", "corpus", "coders", "budget"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 0},
    "state": {"enum": ["draft", "frozen"]},
    "corpus": {
      "type": "object",
      "required": ["snapshot_date", "sources", "queries"],
      "additionalProperties": false,
      "properties": {
        "snapshot_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind", "url", "terms_reference"],
            "properties": {
              "name": {"type": "string"},
              "kind": {"enum": ["bibliographic_snapshot", "bibliographic_api", "citation_contexts", "open_access_fulltext", "community_venue", "manual"]},
              "url": {"type": "string"},
              "terms_reference": {"type": ["string", "null"]}
            }
          }
        },
        "queries": {"type": "object"}
      }
    },
    "coders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["coder_id", "family", "kind"],
        "properties": {
          "coder_id": {"type": "string"},
          "family": {"type": "string"},
          "kind": {"enum": ["automated", "human"]},
          "model_id": {"type": ["string", "null"]},
          "effort": {"type": ["string", "null"]},
          "prompt_set": {"type": ["string", "null"]}
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["currency", "project_ceiling", "per_run_cap", "pricing"],
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string"},
        "project_ceiling": {"type": ["number", "null"], "minimum": 0},
        "per_run_cap": {"type": ["number", "null"], "minimum": 0},
        "pricing": {"type": "object"}
      }
    }
  }
}
