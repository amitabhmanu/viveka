{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/registry/schemas/events.schema.json",
  "title": "Viveka claim and event list (registry/events/<claim>.yaml)",
  "type": "object",
  "required": ["format", "claim", "wording", "events"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 1},
    "claim": {"$ref": "#/$defs/slug"},
    "wording": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "kind", "works", "note", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "kind": {"enum": ["disconfirmation"]},
          "works": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work"}},
          "note": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "work": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["openalex"]}, {"required": ["doi"]}],
      "properties": {
        "openalex": {"type": "string", "pattern": "^W\\d+$"},
        "doi": {"type": "string", "pattern": "^10\\.\\S+/\\S+$"},
        "note": {"type": "string"}
      }
    }
  }
}
