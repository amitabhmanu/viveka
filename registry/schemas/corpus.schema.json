{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/registry/schemas/corpus.schema.json",
  "title": "Viveka corpus registry",
  "type": "object",
  "required": ["version", "state", "sources", "api", "census"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 0},
    "state": {"enum": ["draft", "frozen"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "url", "terms_reference"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "kind": {"enum": ["bibliographic_api", "citation_contexts", "open_access_fulltext", "community_venue", "manual"]},
          "url": {"type": "string"},
          "terms_reference": {"type": ["string", "null"]}
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["openalex", "crossref", "semanticscholar"],
      "additionalProperties": false,
      "properties": {
        "openalex": {
          "type": "object",
          "required": ["daily_usd_cap", "prices_usd", "requests_per_second", "per_page", "doi_batch"],
          "additionalProperties": false,
          "properties": {
            "daily_usd_cap": {"type": "number", "minimum": 0},
            "prices_usd": {
              "type": "object",
              "required": ["singleton", "list", "search", "content"],
              "additionalProperties": {"type": "number", "minimum": 0}
            },
            "requests_per_second": {"$ref": "#/$defs/rate"},
            "per_page": {"type": "integer", "minimum": 1, "maximum": 200},
            "doi_batch": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "crossref": {
          "type": "object",
          "required": ["requests_per_second"],
          "additionalProperties": false,
          "properties": {"requests_per_second": {"$ref": "#/$defs/rate"}}
        },
        "semanticscholar": {
          "type": "object",
          "required": ["requests_per_second", "keyless_requests_per_second", "page_size", "max_offset"],
          "additionalProperties": false,
          "properties": {
            "requests_per_second": {"$ref": "#/$defs/rate"},
            "keyless_requests_per_second": {"$ref": "#/$defs/rate"},
            "page_size": {"type": "integer", "minimum": 1, "maximum": 1000},
            "max_offset": {"type": "integer", "minimum": 2}
          }
        }
      }
    },
    "census": {
      "type": "object",
      "required": ["works_per_year", "max_unmeasured_share", "seed", "resolution", "doiless_sample_per_work",
                   "match_year_tolerance", "paper_types", "reference_classification", "bibliographic_rescue"],
      "additionalProperties": false,
      "properties": {
        "works_per_year": {"type": "integer", "minimum": 1},
        "max_unmeasured_share": {"type": "number", "minimum": 0, "maximum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "resolution": {"enum": ["crossref_doi_plus_sampled_biblio_match"]},
        "doiless_sample_per_work": {"type": "integer", "minimum": 0},
        "match_year_tolerance": {"type": "integer", "minimum": 0, "maximum": 5},
        "paper_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "reference_classification": {"enum": ["crossref_fields_v1"]},
        "bibliographic_rescue": {
          "type": "object",
          "required": ["rule", "min_score", "title_word_share"],
          "additionalProperties": false,
          "properties": {
            "rule": {"enum": ["crossref_bibliographic_v2"]},
            "min_score": {"type": "number", "minimum": 0},
            "title_word_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        }
      }
    },
    "calibration_selection": {
      "type": "object",
      "required": ["overlap_measure", "max_overlap", "core_min_works"],
      "additionalProperties": false,
      "properties": {
        "overlap_measure": {"enum": ["overlap_coefficient_core_v2"]},
        "max_overlap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "core_min_works": {"type": "integer", "minimum": 1}
      }
    },
    "ingestion": {
      "type": "object",
      "required": ["requests_per_second", "text_extraction", "reference_extraction", "catalogue_match",
                   "audit_references", "venues"],
      "additionalProperties": false,
      "properties": {
        "requests_per_second": {"$ref": "#/$defs/rate"},
        "audit_references": {"type": "integer", "minimum": 1},
        "text_extraction": {"enum": ["pypdf_text_v1"]},
        "reference_extraction": {"enum": ["reference_section_v2"]},
        "catalogue_match": {"enum": ["ingested_catalogue_v1"]},
        "venues": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9_]+$"},
          "additionalProperties": {"$ref": "#/$defs/venue"}
        }
      }
    }
  },
  "$defs": {
    "rate": {"type": "number", "exclusiveMinimum": 0},
    "venue": {
      "type": "object",
      "required": ["name", "issn_l", "adapter", "url", "aliases", "default_type"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "issn_l": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{3}[\\dX]$"},
        "adapter": {"enum": ["eprints_json_v1", "orthomolecular_toc_v2", "arj_volumes_v1", "ojs_v1", "bepress_v1"]},
        "type_patterns": {"type": "object", "additionalProperties": {"type": "string"}},
        "url": {"type": "string", "pattern": "^https://"},
        "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "types": {"type": "object", "additionalProperties": {"type": "string"}},
        "default_type": {"type": "string"},
        "first_volume_year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "note": {"type": "string"}
      }
    }
  }
}
