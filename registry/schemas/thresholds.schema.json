{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/registry/schemas/thresholds.schema.json",
  "title": "Viveka parameter registry",
  "type": "object",
  "required": ["version", "state", "parameters"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 0},
    "state": {"enum": ["draft", "frozen"]},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_min_disconfirmations", "m_min_members", "v_min_citations", "r_min_coverage",
        "l_lag_years", "delta", "c_max_insulating_share", "k_min_loop", "j_idle_round_years",
        "interval_level", "t_tau_threshold", "h_honoured_threshold", "h0_min_met_conditions",
        "w_window_years", "o_min_overlap", "sweep", "e_max_error_share",
        "i_max_indeterminate_share", "kappa_min", "q_min_coders", "g_max_leakage_pp",
        "s_max_label_change_share", "bootstrap_draws", "omega_prominence_strata"
      ],
      "properties": {
        "n_min_disconfirmations": {"$ref": "#/$defs/parameter"},
        "m_min_members": {"$ref": "#/$defs/parameter"},
        "v_min_citations": {"$ref": "#/$defs/parameter"},
        "r_min_coverage": {"$ref": "#/$defs/share"},
        "l_lag_years": {"$ref": "#/$defs/parameter"},
        "delta": {"$ref": "#/$defs/share"},
        "c_max_insulating_share": {"$ref": "#/$defs/share"},
        "k_min_loop": {"$ref": "#/$defs/parameter"},
        "j_idle_round_years": {"$ref": "#/$defs/parameter"},
        "interval_level": {"$ref": "#/$defs/share"},
        "t_tau_threshold": {"$ref": "#/$defs/parameter"},
        "h_honoured_threshold": {"$ref": "#/$defs/share"},
        "h0_min_met_conditions": {"$ref": "#/$defs/parameter"},
        "w_window_years": {"$ref": "#/$defs/parameter"},
        "o_min_overlap": {"$ref": "#/$defs/share"},
        "sweep": {"$ref": "#/$defs/parameter"},
        "e_max_error_share": {"$ref": "#/$defs/share"},
        "i_max_indeterminate_share": {"$ref": "#/$defs/share"},
        "kappa_min": {"$ref": "#/$defs/parameter"},
        "q_min_coders": {"$ref": "#/$defs/parameter"},
        "g_max_leakage_pp": {"$ref": "#/$defs/parameter"},
        "s_max_label_change_share": {"$ref": "#/$defs/share"},
        "bootstrap_draws": {"$ref": "#/$defs/count"},
        "omega_prominence_strata": {"$ref": "#/$defs/count"}
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["symbol", "used_in", "meaning", "value", "status", "source_run"],
      "properties": {
        "symbol": {"type": "string"},
        "used_in": {"type": "string"},
        "meaning": {"type": "string"},
        "value": {},
        "status": {"enum": ["fitted", "simulated", "convention"]},
        "source_run": {"type": ["string", "null"]}
      }
    },
    "count": {
      "allOf": [
        {"$ref": "#/$defs/parameter"},
        {"properties": {"value": {"type": ["integer", "null"], "minimum": 1}}}
      ]
    },
    "share": {
      "allOf": [
        {"$ref": "#/$defs/parameter"},
        {"properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}
      ]
    }
  }
}
