{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amitabhmanu/viveka/src/viveka/schemas/run_manifest.schema.json",
  "title": "Viveka run manifest",
  "type": "object",
  "required": [
    "run_id", "stage", "case", "fold", "status", "error", "git_commit", "git_dirty",
    "registry", "inputs", "outputs", "coders", "usage", "seed", "params",
    "started", "ended", "viveka_version"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}Z-[a-z0-9-]+-[0-9a-f]{4}$"},
    "stage": {"type": "string", "minLength": 1},
    "case": {"type": "string", "minLength": 1},
    "fold": {"enum": ["dev", "calibration", "heldout", "pilot", "contested"]},
    "status": {"enum": ["ok", "failed"]},
    "error": {"type": ["string", "null"]},
    "git_commit": {"type": ["string", "null"]},
    "git_dirty": {"type": ["boolean", "null"]},
    "registry": {
      "type": "object",
      "required": ["version", "components"],
      "properties": {
        "version": {"type": "integer", "minimum": 0},
        "components": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artefact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artefact"}},
    "coders": {"type": "array"},
    "usage": {"type": "object"},
    "seed": {"type": ["integer", "null"]},
    "params": {"type": "object"},
    "started": {"type": "string"},
    "ended": {"type": "string"},
    "viveka_version": {"type": "string"}
  },
  "$defs": {
    "artefact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rows": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
